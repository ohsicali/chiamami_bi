{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/resolve-maps.js": {
      "maxDuration": 30
    },
    "api/resolve-reel.js": {
      "maxDuration": 15
    },
    "api/img.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/api/img",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=31536000, max-age=604800, stale-while-revalidate=86400" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/" }
  ]
}
